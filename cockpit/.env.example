# Kopieren nach .env.local und ausfüllen. Niemals echte Werte committen.

# Supabase (lokal: Ausgabe von `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig (lokale Direktanmeldung, Webhook, Cron-Jobs). Nie im Frontend verwenden.
SUPABASE_SERVICE_ROLE_KEY=
# Nur lokal: Anmeldung ohne Mail/Authenticator über /auth/dev-login (in Produktion wirkungslos)
DEV_LOGIN=

# Einzige zugelassene Login-Adresse
ALLOWED_EMAIL=du@cybershark.ch
# Öffentliche Basis-URL der App (für den Magic Link)
APP_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Absenderangaben – werden in jeden Entwurf eingesetzt
SENDER_NAME=Vorname Nachname
SENDER_FIRMA=Cybershark
SENDER_ADRESSE=Strasse 1, 8000 Zürich
SENDER_EMAIL=du@cybershark.ch
SENDER_WEB=https://cybershark.ch
# Einstiegsangebot für Erstnachrichten
OFFER_TEXT=Kostenloser Sichtbarkeits-Check: Ich zeige in 15 Minuten, wie Ihr Betrieb bei Google gefunden wird und wo Anfragen verloren gehen.

# 32 Byte, base64 – für verschlüsselte Zugangsdaten in der DB (ab Woche 2)
# Erzeugen: openssl rand -base64 32
SECRETS_KEY=

# Nur für `npm run test:db` (lokale Postgres-Testdatenbank, wird geleert!)
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cockpit_test
